{
  "datasets": [
    {
      "name": "city_summary",
      "displayName": "city_summary",
      "queryLines": [
        "SELECT city_name, listings, priced_listings, priced_pct, median_price, p25_price, p75_price,\n",
        "       median_availability_365, zero_availability_pct, avg_review_score, hosts, superhost_pct,\n",
        "       multi_listing_host_pct, entire_home_pct, neighbourhoods\n",
        "FROM airbnb_lakehouse.gold.city_summary\n",
        "ORDER BY median_price DESC\n"
      ]
    },
    {
      "name": "room_types",
      "displayName": "room_types",
      "queryLines": [
        "SELECT city_name, room_type, listings, share_pct, median_price\n",
        "FROM airbnb_lakehouse.gold.room_type_summary\n",
        "ORDER BY city_name, listings DESC\n"
      ]
    },
    {
      "name": "top_neighbourhoods",
      "displayName": "top_neighbourhoods",
      "queryLines": [
        "SELECT city_name, neighbourhood, listings, median_price, avg_review_score\n",
        "FROM airbnb_lakehouse.gold.neighbourhood_summary\n",
        "WHERE priced_listings >= 20\n",
        "QUALIFY ROW_NUMBER() OVER (PARTITION BY city ORDER BY median_price DESC) <= 5\n",
        "ORDER BY CASE city WHEN 'paris' THEN 1 WHEN 'lyon' THEN 2 ELSE 3 END, median_price DESC\n"
      ]
    },
    {
      "name": "paris_vs_lyon",
      "displayName": "paris_vs_lyon",
      "queryLines": [
        "WITH s AS (SELECT * FROM airbnb_lakehouse.gold.city_summary WHERE city IN ('paris', 'lyon')),\n",
        "long AS (\n",
        "  SELECT city, metric, value FROM s\n",
        "  LATERAL VIEW STACK(9,\n",
        "    '1 Listings', CAST(listings AS DOUBLE),\n",
        "    '2 Share with a price (%)', CAST(priced_pct AS DOUBLE),\n",
        "    '3 Median price (EUR)', CAST(median_price AS DOUBLE),\n",
        "    '4 Entire-home share (%)', CAST(entire_home_pct AS DOUBLE),\n",
        "    '5 Median available days / year', CAST(median_availability_365 AS DOUBLE),\n",
        "    '6 Listings with 0 available days (%)', CAST(zero_availability_pct AS DOUBLE),\n",
        "    '7 Average review score', CAST(avg_review_score AS DOUBLE),\n",
        "    '8 Multi-listing hosts (%)', CAST(multi_listing_host_pct AS DOUBLE),\n",
        "    '9 Superhosts (%)', CAST(superhost_pct AS DOUBLE)) t AS metric, value)\n",
        "SELECT SUBSTRING(metric, 3) AS metric,\n",
        "       ROUND(MAX(CASE WHEN city = 'paris' THEN value END), 2) AS paris,\n",
        "       ROUND(MAX(CASE WHEN city = 'lyon' THEN value END), 2) AS lyon,\n",
        "       ROUND(100 * (MAX(CASE WHEN city = 'lyon' THEN value END) / MAX(CASE WHEN city = 'paris' THEN value END) - 1), 1) AS lyon_vs_paris_pct\n",
        "FROM long GROUP BY metric ORDER BY metric\n"
      ]
    },
    {
      "name": "room_price_by_city",
      "displayName": "room_price_by_city",
      "queryLines": [
        "SELECT city_name, room_type, median_price, listings\n",
        "FROM airbnb_lakehouse.gold.room_type_summary\n",
        "WHERE listings >= 20\n",
        "ORDER BY room_type, city_name\n"
      ]
    },
    {
      "name": "price_by_guests",
      "displayName": "price_by_guests",
      "queryLines": [
        "SELECT city_name, LEAST(accommodates, 8) AS guests, PERCENTILE(price, 0.5) AS median_price, COUNT(*) AS listings\n",
        "FROM airbnb_lakehouse.gold.listing_features\n",
        "WHERE price IS NOT NULL AND room_type = 'Entire home/apt'\n",
        "GROUP BY ALL ORDER BY city_name, guests\n"
      ]
    },
    {
      "name": "model_metrics",
      "displayName": "model_metrics",
      "queryLines": [
        "SELECT model, INITCAP(city) AS city, variant, labeled_listings, model_mae_eur, baseline_mae_eur, improvement_eur\n",
        "FROM airbnb_lakehouse.gold.v_model_metrics\n",
        "ORDER BY model, city, variant\n"
      ]
    },
    {
      "name": "mae_by_city_and_model",
      "displayName": "mae_by_city_and_model",
      "queryLines": [
        "SELECT INITCAP(city) AS city,\n",
        "       CASE WHEN run_id = 'france_v1' THEN 'v1 (week 1)'\n",
        "            WHEN variant = 'uncalibrated' THEN 'v2 without city prices'\n",
        "            ELSE 'v2 (week 2)' END AS model_variant,\n",
        "       model_mae_eur AS mae_eur\n",
        "FROM airbnb_lakehouse.gold.v_model_metrics\n",
        "WHERE city <> 'combined'\n",
        "UNION ALL\n",
        "SELECT INITCAP(city), 'Baseline', baseline_mae_eur\n",
        "FROM airbnb_lakehouse.gold.v_model_metrics\n",
        "WHERE city <> 'combined' AND run_id = 'france_v2' AND variant IN ('holdout', 'calibrated')\n",
        "ORDER BY city, model_variant\n"
      ]
    },
    {
      "name": "predicted_vs_actual_v2",
      "displayName": "predicted_vs_actual_v2",
      "queryLines": [
        "SELECT city_name, actual_price_eur, predicted_price_eur\n",
        "FROM airbnb_lakehouse.gold.v_test_predictions\n",
        "WHERE run_id = 'france_v2' AND actual_price_eur <= 1000\n"
      ]
    },
    {
      "name": "error_by_room_type",
      "displayName": "error_by_room_type",
      "queryLines": [
        "SELECT model, city_name, room_type, COUNT(*) AS listings,\n",
        "       ROUND(AVG(absolute_error_eur), 2) AS model_mae_eur,\n",
        "       ROUND(AVG(baseline_absolute_error_eur), 2) AS baseline_mae_eur,\n",
        "       ROUND(AVG(residual_eur), 2) AS mean_residual_eur\n",
        "FROM airbnb_lakehouse.gold.v_test_predictions\n",
        "GROUP BY ALL HAVING COUNT(*) >= 10\n",
        "ORDER BY city_name, room_type, model\n"
      ]
    },
    {
      "name": "error_by_room_type_v2",
      "displayName": "error_by_room_type_v2",
      "queryLines": [
        "SELECT CONCAT(city_name, ' - ', room_type) AS segment, ROUND(AVG(absolute_error_eur), 2) AS model_mae_eur\n",
        "FROM airbnb_lakehouse.gold.v_test_predictions\n",
        "WHERE run_id = 'france_v2'\n",
        "GROUP BY city_name, room_type HAVING COUNT(*) >= 10\n",
        "ORDER BY model_mae_eur DESC\n"
      ]
    },
    {
      "name": "error_by_neighbourhood_v2",
      "displayName": "error_by_neighbourhood_v2",
      "queryLines": [
        "SELECT city_name, neighbourhood, COUNT(*) AS listings,\n",
        "       ROUND(AVG(absolute_error_eur), 2) AS model_mae_eur,\n",
        "       ROUND(AVG(residual_eur), 2) AS mean_residual_eur\n",
        "FROM airbnb_lakehouse.gold.v_test_predictions\n",
        "WHERE run_id = 'france_v2'\n",
        "GROUP BY ALL HAVING COUNT(*) >= 15\n",
        "ORDER BY model_mae_eur DESC LIMIT 15\n"
      ]
    },
    {
      "name": "most_mispriced_v2",
      "displayName": "most_mispriced_v2",
      "queryLines": [
        "SELECT city_name, error_direction, name, neighbourhood, room_type, accommodates,\n",
        "       actual_price_eur, predicted_price_eur, residual_eur, listing_url\n",
        "FROM airbnb_lakehouse.gold.v_test_predictions\n",
        "WHERE run_id = 'france_v2' AND price_flag <> 'extreme'\n",
        "ORDER BY ABS(residual_eur) DESC LIMIT 30\n"
      ]
    }
  ],
